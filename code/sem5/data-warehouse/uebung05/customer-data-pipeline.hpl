  <transform>
    <type>FilterRows</type>
    <name>Filter rows</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>Country</leftvalue>
        <function>&lt;></function>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>United Kingdom</text>
          <length>-1</length>
          <precision>-1</precision>
