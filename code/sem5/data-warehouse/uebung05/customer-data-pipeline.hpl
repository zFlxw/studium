  <transform>
    <type>Formula</type>
    <name>Formula</name>
    <formulas>
      <formula>
        <field_name>Umsatz_EUR</field_name>
        <formula>[Quantity] * [UnitPrice] * 1.1865</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>Datum</field_name>
        <formula>DATE(YEAR([InvoiceDate]), MONTH([InvoiceDate]), DAY([InvoiceDate]))</formula>
        <value_type>3</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
    </formulas>
